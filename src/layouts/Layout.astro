---
import "../styles/global.css";
import { ClientRouter, fade, slide } from "astro:transitions";
import bgVideo from "../assets/furina.mp4";
import { Image } from "astro:assets";
import Setup from "../assets/setup.png";
const linkSmkn = "https://smkn1sumbawa.sch.id/";
const username = "SiloKusuma";
const res = await fetch(`https://api.github.com/users/${username}`);
const data = await res.json();

let reposData = [];
try {
  const reposRes = await fetch(`https://api.github.com/users/${username}/repos?sort=stars&per_page=6&type=owner&direction=desc`);
  if (reposRes.ok) {
    reposData = await reposRes.json();
  }
} catch (e) {
  // fallback to client-side fetch
}
